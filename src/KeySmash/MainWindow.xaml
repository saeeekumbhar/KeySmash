<Window x:Class="KeySmash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeySmash"
        mc:Ignorable="d"
        Title="KeySmash"
        Width="400" Height="650"
        MinWidth="380" MinHeight="620"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDarkBrush" Color="#12151C"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1A1E27"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#272E3B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF2F6"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E9AA8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="ControlBgBrush" Color="#222834"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#2B3242"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI, -apple-system, sans-serif"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernSlider" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Height="24">
                            <!-- Track Background -->
                            <Border Height="6" Background="{StaticResource ControlBgBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="3" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                            <!-- Interactive Track -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="6" Background="{StaticResource AccentBrush}"
                                                        CornerRadius="3" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Width="22" Height="22" Background="Transparent" Cursor="Hand">
                                                    <Ellipse x:Name="ThumbGrip" Width="16" Height="16"
                                                             Fill="{StaticResource TextPrimaryBrush}"
                                                             Stroke="{StaticResource AccentBrush}"
                                                             StrokeThickness="2.5"
                                                             SnapsToDevicePixels="True"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbGrip" Property="Fill" Value="White"/>
                                                        <Setter TargetName="ThumbGrip" Property="Stroke" Value="{StaticResource AccentHoverBrush}"/>
                                                        <Setter TargetName="ThumbGrip" Property="Width" Value="18"/>
                                                        <Setter TargetName="ThumbGrip" Property="Height" Value="18"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbGrip" Property="Fill" Value="{StaticResource AccentHoverBrush}"/>
                                                        <Setter TargetName="ThumbGrip" Property="Stroke" Value="White"/>
                                                        <Setter TargetName="ThumbGrip" Property="Width" Value="18"/>
                                                        <Setter TargetName="ThumbGrip" Property="Height" Value="18"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Controls -->
            <RowDefinition Height="Auto"/> <!-- Footer / Privacy Note -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="KeySmash" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="custom keyboard sound effects" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Enable / Disable Card -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="keyboard sounds" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="StatusLabel" Text="Enabled" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="EnableToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ModernCheckBox}"
                                  IsChecked="True"
                                  Checked="EnableToggle_Checked" Unchecked="EnableToggle_Unchecked"/>
                    </Grid>
                </Border>

                <!-- Sound Selection Card -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="sound" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="SoundPackCombo"
                                  Height="36"
                                  Background="{StaticResource ControlBgBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource CardBorderBrush}"
                                  SelectionChanged="SoundPackCombo_SelectionChanged"
                                  FontSize="13">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding DisplayType}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Volume Card -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="volume" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="VolumeValueLabel" Text="75%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="75"
                                    Style="{StaticResource ModernSlider}"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                            <Button x:Name="MuteButton" Grid.Column="1" Margin="10,0,0,0"
                                    Content="Mute" Style="{StaticResource ModernButton}"
                                    Padding="10,4" FontSize="11"
                                    Click="MuteButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Playback Options & Preview -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="RandomizeCheckBox"
                                  Content="randomize sounds"
                                  Style="{StaticResource ModernCheckBox}"
                                  IsChecked="True"
                                  Margin="0,0,0,10"
                                  Checked="RandomizeCheckBox_Changed" Unchecked="RandomizeCheckBox_Changed"/>
                        <Button x:Name="PreviewButton"
                                Content="preview"
                                Style="{StaticResource ModernButton}"
                                Height="34"
                                Click="PreviewButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Sound Packs Management -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="sound packs" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+ add pack"
                                    ToolTip="Import .wav, .mp3, or .zip sound pack"
                                    Style="{StaticResource ModernButton}"
                                    Height="32"
                                    Click="AddSoundButton_Click"/>
                            <Button Grid.Column="2" Content="open folder"
                                    ToolTip="Open custom sounds directory in Windows Explorer"
                                    Style="{StaticResource ModernButton}"
                                    Height="32"
                                    Click="OpenFolderButton_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DeletePackButton" Grid.Column="0" Content="delete pack"
                                    ToolTip="Delete selected custom sound pack"
                                    Style="{StaticResource ModernButton}"
                                    Height="32"
                                    Click="DeletePackButton_Click"/>
                            <Button Grid.Column="2" Content="refresh"
                                    ToolTip="Rescan sounds directory for new or modified packs"
                                    Style="{StaticResource ModernButton}"
                                    Height="32"
                                    Click="RefreshPacksButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Settings Card -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="settings" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="StartupCheckBox"
                                  Content="start KeySmash with Windows"
                                  Style="{StaticResource ModernCheckBox}"
                                  Margin="0,0,0,8"
                                  Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>
                        <TextBlock Text="Quick-mute hotkey: Ctrl + Shift + M"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,8,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="FooterStatusLabel" Text="Offline • No keys logged"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="v1.0"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
